{
	admin off
	persist_config off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

# Explicit public ACME issuer: IP sites otherwise default to Caddy's local CA.
https://{$YOLO_PUBLIC_IP} {
	bind {$YOLO_PUBLIC_IP}
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_http_challenge
		}
	}
	header >X-Content-Type-Options nosniff
	header ?Referrer-Policy strict-origin-when-cross-origin
	request_body {
		max_size 1073741824
	}
	@api path /api /api/* /static /static/* /docs /docs/* /redoc /redoc/* /openapi.json
	handle @api {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			header_up X-Forwarded-Proto https
		}
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control no-store
		file_server
	}
}
