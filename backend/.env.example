# ============================
# Backend Environment Variables
# ============================
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file to version control.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=yolo

# --- JWT ---
SECRET_KEY=change_this_to_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
STATIC_URL_EXPIRE_SECONDS=3600

# --- DeepSeek API ---
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# --- Chat Provider ---
# 可選值：openai | deepseek | ollama | mock
# 本地開發建議 ollama（免費）或 mock（無需模型）
CHAT_PROVIDER=openai
CHAT_REQUEST_TIMEOUT=60
CHAT_CONTEXT_MAX_TURNS=10
CHAT_SYSTEM_PROMPT=You are a concise, helpful assistant for the YOLO System application.
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- LLM 存取政策（/api/chat 與 /api/agent 共用）---
# 前端可選的模型白名單（逗號分隔）；各 provider 的預設模型永遠允許。
# 留空 = 內建預設（OpenAI: gpt-4.1-mini, gpt-4o；DeepSeek: deepseek-chat, deepseek-reasoner）。
# Ollama 只允許本機已安裝的模型（/api/tags）。
OPENAI_ALLOWED_MODELS=
DEEPSEEK_ALLOWED_MODELS=
# 每位使用者每分鐘的 LLM 請求上限（所有 provider 合計；0 = 不限制）
LLM_RATE_LIMIT_PER_MINUTE=20
# 每位使用者每日付費 provider（openai / deepseek）請求上限（0 = 不限制）
LLM_PAID_DAILY_LIMIT=200

# --- Ollama (本地免費模型) ---
# 啟用方式：CHAT_PROVIDER=ollama
# 確認 Ollama 已安裝並執行：ollama serve
# 下載模型範例：ollama pull gemma4 / ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- YOLO ---
YOLO_DEFAULT_MODEL_KEY=seven_class_asff
# Deprecated fallback for legacy integrations; Web/API inference uses the registry key above.
YOLO_DEFAULT_MODEL=../yolo11n.pt
YOLO_RESULTS_DIR=static/results
DETECTION_SOURCE_DIR=static/detections/originals
DETECTION_RESULT_DIR=static/detections/results
DETECTION_VIDEO_SOURCE_DIR=static/detections/videos/originals
DETECTION_VIDEO_RESULT_DIR=static/detections/videos/results
DETECTION_PREVIEW_DIR=static/detections/previews
# 一次批次上傳（多張影像/整個資料夾）最多允許的張數；先以 100 上線，
# 觀察背景處理吞吐量後再視情況調高（例如 500）。
DETECTION_BATCH_MAX_FILES=100
# 各類別自訂閾值（per-class conf/IOU）時的候選框上限。這種模式會先關閉
# Ultralytics 內建 NMS（iou=1.0）取得原始候選框，再依各類別自己的 IOU
# 重新抑制；因為 max_det 是在 NMS 之後才套用，維持預設 300 會讓密集影像
# 在我們自己抑制之前就被截斷，所以這裡放大。僅影響 per-class 請求。
DETECTION_PERCLASS_MAX_DET=3000

# --- Agent (Phase 6A-1) ---
# Agentic layer settings for /api/agent/*.
# Leave AGENT_PROVIDER / AGENT_MODEL empty to inherit CHAT_PROVIDER / OPENAI_CHAT_MODEL.
# Set AGENT_PROVIDER=mock for local development without external API keys.
AGENT_PROVIDER=
AGENT_MODEL=
AGENT_ENABLE_DEEPAGENTS=false
# Agent 引擎：pipeline（預設，後端先查資料再呼叫一次 LLM）或 tool_calling
# （LangChain create_agent，模型自行呼叫唯讀工具；需支援 tool calling 的模型，
# 本機實測 gemma4 比 qwen2.5 穩定）。mock / report 模式 / 開啟 vision 的 explain 會自動走 pipeline。
AGENT_ENGINE=pipeline
# tool_calling 引擎每次請求最多呼叫工具的次數
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_HISTORY_TURNS=10
AGENT_RECURSION_LIMIT=25
# 啟用後，explain_detection / report 模式會附上偵測結果圖（annotated, base64）給 LLM，
# 讓「有視覺能力」的模型（如 OpenAI gpt-4o / gpt-4.1、Ollama llava / qwen2-vl 等）能直接
# 讀取影像內容作答，而不只是讀 bounding box 統計數字。
# 若目前設定的 provider/model 不支援圖片輸入（例如純文字模型），開啟後該次請求會失敗，
# agent 會回覆「AI 模型目前無法完成回覆」，不會造成後端錯誤。
AGENT_ENABLE_VISION=false
AGENT_VISION_MAX_IMAGE_BYTES=6291456
AGENT_SYSTEM_PROMPT=You are the YOLO System assistant. You help users understand YOLO detection results, analyse their detection history, and produce concise reports. You never run YOLO inference yourself; you only read existing detection records. You never modify or delete data.

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
